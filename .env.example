# ========================================================
# CivicTrack — Environment Configuration Template
# Copy this file to server/.env and adjust as needed
# ========================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If left empty or local connection fails, CivicTrack gracefully falls back to an embedded in-memory MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/civictrack

# JWT Authentication Secret & Expiration
JWT_SECRET=civictrack_super_secure_jwt_secret_key_hackathon_2025
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used during auto-seed if seed.js is run)
ADMIN_NAME=Admin Officer
ADMIN_EMAIL=admin@civictrack.org
ADMIN_PASSWORD=Admin@12345

# Allowed Client Origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Cloudinary configuration for production image hosting
# If not provided, CivicTrack uses robust local multipart uploads under /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
