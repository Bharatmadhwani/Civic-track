{
  "name": "civictrack",
  "version": "1.0.0",
  "description": "CivicTrack — Smart Community Issue Reporting Platform",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix client",
    "vercel-build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "start": "npm run start --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "test:server": "npm run test --prefix server",
    "build:client": "npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "civic-tech",
    "mern",
    "community-reporting",
    "smart-city"
  ],
  "author": "CivicTrack Team",
  "license": "MIT"
}
